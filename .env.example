# Copy to .env (git-ignored) or set these in your hosting provider's environment settings.
# Make a key pair with:  python -m backend.push keygen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org

# Optional: where alerts are stored (default data/alerts.sqlite3)
# ALERTS_DB=/var/lib/dengue-watch/alerts.sqlite3

# Optional: alert thresholds (defaults in dengue_ews/config.py)
# ALERT_HORIZON=2
# ALERT_SURGE_PCT=50
# ALERT_SURGE_MIN_CASES=3
# ALERT_RAIN_PERCENTILE=0.9
# ALERT_RAIN_ABS_MM=450
# ALERT_RAIN_MIN_MM=100
# ALERT_COOLDOWN_WEEKS=3
# ALERT_SCAN_MINUTES=15

# ---------------------------------------------------------------------------------------------- accounts and sign-in
# Long random secret for OTP hashes and CSRF tokens. If empty, one is generated into data/.auth_secret (git-ignored).
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
# AUTH_DB=data/auth.sqlite3
LOGIN_SESSION_EXPIRY_MINUTES=60      # idle timeout (each request slides it forward)
LOGIN_SESSION_MAX_HOURS=12           # absolute limit for a normal session
LOGIN_REMEMBER_DAYS=30               # absolute limit with "Remember me"
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5                   # codes per phone/email per hour
OTP_MAX_PER_IP_HOUR=20
AUTH_LOCKOUT_THRESHOLD=5             # wrong passwords before a lock (15 min, doubling each time, max 24 h)
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PUBLIC_REGISTRATION=true        # false = accounts only by administrator invitation
AUTH_REQUIRE_APPROVAL=false          # true = new sign-ups wait for an administrator before they can sign in
AUTH_DEFAULT_ROLE=officer            # role of a new sign-up: officer | analyst | field | viewer (never admin)
AUTH_REQUIRE_EMAIL_VERIFICATION=true # only applies when the account has an email and SMTP is set up
AUTH_ALLOW_OTP_LOGIN=true            # passwordless sign-in with a code to a verified phone
AUTH_REQUIRE_OTP_ROLES=              # e.g. admin,officer: these roles must pass a code at every sign-in
AUTH_ESSENTIAL_EVENTS=suspicious_login,password_change   # alerts users cannot turn off
AUTH_COOKIE_SECURE=auto              # auto = Secure when served over https; set true behind a TLS proxy
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_TRUSTED_PROXIES=1               # proxies in front of the API that append X-Forwarded-For (Next.js = 1)
# AUTH_LOCATION_HEADER=CF-IPCountry  # only if a trusted CDN adds a location header; otherwise no location is shown
AUTH_TIMEZONE=Asia/Dhaka
PUBLIC_BASE_URL=                     # https URL providers can reach, for delivery-status callbacks

# SMS: twilio | sslwireless (leave empty to switch SMS off; nothing is ever pretended to be sent)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=                     # a Twilio number in E.164, or use TWILIO_MESSAGING_SERVICE_SID
TWILIO_MESSAGING_SERVICE_SID=
SSLWIRELESS_API_TOKEN=
SSLWIRELESS_SID=                     # approved sender id / masking
# SSLWIRELESS_URL=https://smsplus.sslwireless.com

# WhatsApp (official Business Platform only): meta | twilio
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=               # Meta system-user token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_OTP=               # approved Authentication template (1 body variable + copy-code button)
WHATSAPP_TEMPLATE_SECURITY=          # approved Utility template with 5 body variables: name, event, date, time, device
WHATSAPP_TEMPLATE_LANG_EN=en
WHATSAPP_TEMPLATE_LANG_BN=bn
WHATSAPP_APP_SECRET=                 # verifies webhook signatures (delivery status)
WHATSAPP_VERIFY_TOKEN=               # any random string, entered in the Meta webhook settings
TWILIO_WHATSAPP_FROM=                # e.g. +14155238886
TWILIO_WHATSAPP_CONTENT_SID_OTP=     # approved Content template (variable 1 = code)
TWILIO_WHATSAPP_CONTENT_SID_SECURITY=  # approved Content template (variables 1-5 as above)

# Email codes (verification and password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---------------------------------------------------------------------------------------------- Area Intelligence
AREA_PUBLIC=true                     # false = reading area dashboards needs a sign-in
# AREA_DB=data/area.sqlite3          # hospital directory, localities, geocode cache
AREA_FRESH_HOURS=24                  # a verified bed report older than this is "out of date" and not counted
AREA_LIVE_MINUTES=30                 # only API reports newer than this are called "live"
GEOCODER=nominatim                   # nominatim | off  (online place search, only when a user asks for it)
# NOMINATIM_URL=https://nominatim.openstreetmap.org   # use your own instance for heavy traffic
# GEOCODER_USER_AGENT=DengueWatch-Server/2.0 (contact: ops@example.org)
# DGHS Facility Registry (FRED API); credentials are issued by DGHS MIS
FACILITY_REGISTRY_URL=
FACILITY_REGISTRY_TOKEN=
# FACILITY_REGISTRY_AUTH_HEADER=X-Auth-Token
